# ============================================================================
# SECRETS - all required. There are no in-code default values (NFR-SEC-03).
# If SESSION_SECRET is missing the server still BOOTS, then 500s every request.
# ============================================================================

MONGO_URI=

# Signs the connect.sid session cookie (express-session). Signs no JWT, despite what its
# old name (JWT_SECRET) suggested. Renamed 2026-08-23, decision D12.
SESSION_SECRET=

# Signs and verifies the API access tokens (jsonwebtoken). Was JWT_SECRET_KEY.
# MUST be a DIFFERENT value from SESSION_SECRET (NFR-SEC-02) - different mechanisms, so
# one leaking must not compromise the other, and each can be rotated independently.
JWT_ACCESS_SECRET=

# Token lifetimes (FR-AUTH-02). Access tokens are short because they cannot be revoked;
# refresh tokens are long but ARE revocable, because they are tracked in the database.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

#Frontend url
FRONTEND_URL=http://localhost:5173

# ============================================================================
# EMAIL - OTP delivery via Resend's HTTP API (decision, 2026-08-25, supersedes D13).
#
# Raw SMTP (Gmail, port 587) never worked once deployed: on Render specifically, outbound
# SMTP is blocked at the network level (a common anti-spam restriction on PaaS platforms -
# confirmed by watching a literal, correctly-resolved IPv4 address still hit a bare
# connection timeout, which rules out a DNS problem). Resend is a plain HTTPS POST on port
# 443, the same port every other outbound call this app makes already uses successfully.
#
# Get RESEND_API_KEY from resend.com. MAIL_FROM can stay as the sandbox sender below
# (works immediately, no setup) or your own verified domain once you have one.
# ============================================================================
RESEND_API_KEY=
MAIL_FROM=Cortex <onboarding@resend.dev>

# ============================================================================
# REDIS (Upstash) - OTP rate limiting and refresh-token reuse tracking.
# Introduced minimally in SVC-1; SVC-5 extends this same instance (FR-SCALE-01).
# ============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LLMS API Key
OPENROUTER_API_KEY=
TAVILY_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Agent models. Optional - the defaults below are used if unset.
#
# All run through OpenRouter. Groq was dropped: it retired the Llama models this project
# used, and every model left on its free tier is a reasoning or agentic model that
# misbehaves here - they emit tool calls the agent doesn't expect, or bury the answer in a
# reasoning field. Providers retire model ids often, so if the agent starts replying "model
# does not exist", set these to something current.
ORCHESTRATOR_MODEL=deepseek/deepseek-v4-flash
GREETING_MODEL=deepseek/deepseek-v4-flash
GENERAL_MODEL=deepseek/deepseek-chat
RAG_MODEL=deepseek/deepseek-chat
CODING_MODEL=deepseek/deepseek-r1
SEARCH_MODEL=deepseek/deepseek-chat

# Ceiling on tool calls the orchestrator can make in a single turn, so one open-ended
# question can't loop indefinitely. Optional - defaults to 5 if unset.
MAX_TOOL_CALLS_PER_TURN=5

# For Vector Data base
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=cortex_documents

# The embedding model decides the vector size, and the Qdrant collection must be
# created with that exact size or every upload fails on a dimension mismatch.
#   gemini-embedding-001 -> 3072
#   text-embedding-004   -> 768
EMBEDDING_MODEL=gemini-embedding-001

# For Oauth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
